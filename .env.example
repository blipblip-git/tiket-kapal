# Daftar environment variable yang WAJIB ada.
# - Lokal  : copy file ini jadi `.env.local` lalu isi nilainya.
# - Vercel : Settings -> Environment Variables (centang Production + Preview + Development),
#            lalu REDEPLOY supaya nilai barunya kepakai.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-dari-supabase

# Server-only (JANGAN dikasih prefix NEXT_PUBLIC_).
# Dipakai API /api/superadmin/tambah-penyewa & /api/superadmin/hapus-penyewa.
SUPABASE_SERVICE_ROLE_KEY=service-role-key-dari-supabase

# Kunci tanda tangan token sesi API internal (kolektor).
# WAJIB diisi string acak panjang di Vercel. Cara membuat:
#   openssl rand -hex 32
# Kalau kosong, kode memakai SUPABASE_SERVICE_ROLE_KEY sebagai cadangan — selama
# itu token kolektor ikut tidak berlaku bila service role key dirotasi.
SESI_TOKEN_SECRET=ganti-dengan-string-acak-panjang

# --- Alamat situs & mesin pencari --------------------------------------------
# Domain resmi (sudah aktif). Dipakai metadataBase, canonical, robots.txt,
# sitemap.xml, dan link absolut. Jangan pakai tiket-kapal.vercel.app di sini.
NEXT_PUBLIC_SITE_URL=https://www.lintasair.com

# true  = situs boleh diindeks Google (kondisi produksi sekarang).
# false = seluruh situs ditutup dari Google (robots disallow + sitemap kosong).
# Matikan sementara kalau ada perbaikan besar yang belum boleh muncul di Google.
NEXT_PUBLIC_INDEXABLE=true

# Opsional: domain lain yang boleh memanggil /api/publik/* (pisahkan koma).
# Host tempat aplikasi berjalan sudah otomatis diizinkan, jadi biasanya kosong.
PUBLIK_ALLOWED_ORIGINS=

# --- Backup harian (hanya untuk mesin lokal, tidak perlu di Vercel) ----------
# Dipakai scripts/backup-db.sh kalau ingin dump penuh lewat pg_dump.
# Ambil dari Supabase -> Project Settings -> Database -> Connection string (URI).
# Kalau kosong, backup jalan lewat REST (isi tabel public, lihat docs/BACKUP.md).
SUPABASE_DB_URL=

# --- DEMO (project Supabase TERPISAH) ---------------------------------------
# Demo BUKAN salinan data produksi. Demo dibangun dari skema yang sama dan
# dibiarkan kosong (tanpa kapal/jadwal/penumpang/tiket/fee contoh).
#
# Di deployment REAL (www.lintasair.com), isi 3 nilai ini supaya Superadmin
# bisa membaca daftar penyewa + fee demo lewat server:
DEMO_SUPABASE_URL=https://xxxxxxxxxxxx-demo.supabase.co
DEMO_SUPABASE_SERVICE_ROLE_KEY=service-role-key-project-demo
NEXT_PUBLIC_DEMO_URL=https://demo.lintasair.com
#
# Di deployment DEMO (demo.lintasair.com):
# - NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
#   harus berisi kredensial project demo, BUKAN project real.
# - Set DEMO_MODE=true supaya /superadmin, /dashboard-superadmin, dan
#   /api/superadmin/* tidak bisa dibuka.
# - Set NEXT_PUBLIC_INDEXABLE=false supaya demo tidak diindeks Google.
DEMO_MODE=false
