# Daftar environment variable yang WAJIB ada.
# - Lokal  : copy file ini jadi `.env.local` lalu isi nilainya.
# - Vercel : Settings -> Environment Variables (centang Production + Preview + Development),
#            lalu REDEPLOY supaya nilai barunya kepakai.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-dari-supabase

# Server-only (JANGAN dikasih prefix NEXT_PUBLIC_).
# Dipakai API /api/superadmin/tambah-penyewa & /api/superadmin/hapus-penyewa.
SUPABASE_SERVICE_ROLE_KEY=service-role-key-dari-supabase

# Kunci tanda tangan token sesi API internal (kolektor). Kalau kosong, kode
# memakai SUPABASE_SERVICE_ROLE_KEY sebagai cadangan — sebaiknya diisi nilai acak.
SESI_TOKEN_SECRET=ganti-dengan-string-acak-panjang

# --- Alamat situs & mesin pencari --------------------------------------------
# Dipakai untuk metadataBase, robots.txt, dan link absolut.
# Masa uji coba: biarkan tiket-kapal.vercel.app dan indeks dimatikan.
NEXT_PUBLIC_SITE_URL=https://tiket-kapal.vercel.app

# false = seluruh situs ditutup dari Google (masa uji coba / vercel.app).
# true  = boleh diindeks — HANYA setelah domain resmi (www.lintasair.com) aktif.
NEXT_PUBLIC_INDEXABLE=false

# Opsional: domain lain yang boleh memanggil /api/publik/* (pisahkan koma).
# Host tempat aplikasi berjalan sudah otomatis diizinkan, jadi biasanya kosong.
PUBLIK_ALLOWED_ORIGINS=
