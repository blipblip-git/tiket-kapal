# Daftar environment variable yang WAJIB ada.
# - Lokal  : copy file ini jadi `.env.local` lalu isi nilainya.
# - Vercel : Settings -> Environment Variables (centang Production + Preview + Development),
#            lalu REDEPLOY supaya nilai barunya kepakai.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-dari-supabase

# Server-only (JANGAN dikasih prefix NEXT_PUBLIC_).
# Dipakai API /api/superadmin/tambah-penyewa & /api/superadmin/hapus-penyewa.
SUPABASE_SERVICE_ROLE_KEY=service-role-key-dari-supabase
